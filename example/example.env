# Optional prefills; you can also enter both in the app.
EXPO_PUBLIC_COINFLOW_MERCHANT_ID=
EXPO_PUBLIC_COINFLOW_ENV=sandbox
# Optional. When set, "Send request" calls this URL with the x-device-id header attached.
EXPO_PUBLIC_CHARGE_URL=
# Set to 1 to collect once on launch and log COINFLOW_FRAUD_RESULT to the Metro console.
EXPO_PUBLIC_COINFLOW_FRAUD_AUTORUN=
# Optional prefill for the card checkout's session key: a customer session key from
# GET /api/auth/session-key, which your backend fetches with your API key.
EXPO_PUBLIC_COINFLOW_SESSION_KEY=
